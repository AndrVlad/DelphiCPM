procedure TwinMain.FilterReset;
var
  msg: string;
begin
  msg:= '00E0';

  case ConnectionType of
  1: WriteCOM(msg,0);
  2: WriteEthernet(msg,0);
  end;

  ShowMessage('Сообщение отправлено');
end;

