unit SetPorog;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.StdCtrls, Vcl.Samples.Spin;

type
  TPorogSet = class(TForm)
    Button1: TButton;
    Button2: TButton;
    Label1: TLabel;
    Label2: TLabel;
    SpinEdit1: TSpinEdit;
    ComboBox1: TComboBox;
    procedure SpinEdit1Change(Sender: TObject);
    procedure ComboBox1Change(Sender: TObject);
    procedure Button2Click(Sender: TObject);
    procedure Button1Click(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  PorogSet: TPorogSet;
  ChannelNum: Byte;
  Val: Byte;

implementation

uses TransmitReceiveCOM,pr1,ModbusTransmitReceive;

{$R *.dfm}

procedure TPorogSet.Button1Click(Sender: TObject);
begin
  PorogSet.Close;
end;

procedure TPorogSet.Button2Click(Sender: TObject);
var
  msg: string;
  temp: Integer;
begin

  if (Val = -1) or (ChannelNum = -1) then
  begin
    ShowMessage('Ошибка! Не выбран источник или не введено напряжение');
    Exit;
  end;

  temp := 127 + Val;

  if (ChannelNum > 15) then
  begin
     msg := msg+IntToHex(temp,1)+IntToHex(ChannelNum-16,1)+'C';
  end
  else
  begin
     msg := msg+IntToHex(temp,1)+IntToHex(ChannelNum,1)+'C';
  end;
  Val := 0;
  ChannelNum := 0;

  case ConnectionType of
  1: WriteCOM(msg,0);
  2: WriteEthernet(msg,0);
  end;

  PorogSet.Close;
end;

procedure TPorogSet.ComboBox1Change(Sender: TObject);
var
  CI:TStrings;
begin
  CI := ComboBox1.Items;
  ChannelNum := ComboBox1.ItemIndex + 1;
end;

procedure TPorogSet.SpinEdit1Change(Sender: TObject);
begin
  Val := SpinEdit1.Value+1;
end;

end.
